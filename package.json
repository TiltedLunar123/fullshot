{
  "name": "fullshot",
  "version": "1.1.1",
  "description": "Full page screenshot extension for Chrome and Firefox. Correct on sticky headers, lazy images and app UIs.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "icons": "node tools/icons.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:tools": "node tools/e2e-tools.mjs",
    "e2e:modes": "node tools/e2e-modes.mjs",
    "e2e:scroll": "node tools/e2e-scroll.mjs",
    "e2e:overlay": "node tools/e2e-overlay.mjs",
    "zip": "node tools/build.mjs --zip",
    "all": "node tools/build.mjs --zip --check && node --test test/*.test.mjs"
  },
  "license": "MIT"
}
